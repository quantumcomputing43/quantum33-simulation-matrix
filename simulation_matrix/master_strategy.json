        "PCA25",
        "R3_miR21_only",
        "frozen_R8D",
        "randomized_shuffled_R8D"
      ],
      "leakage_rule": "No preprocessing, feature selection, model fitting, threshold selection, or control selection may use held-out outcomes."
    }
  },
  "stop_rules": [
    "STOP_ON_INFRASTRUCTURE_FAILURE",
    "STOP_ON_UNRESOLVED_IMPLEMENTATION_FAILURE",
    "STOP_CASE_ON_MISSING_REQUIRED_INPUT",
    "STOP_SCIENTIFIC_EXECUTION_WHEN_GATE_CLOSED",
    "STOP_ON_NULL_OR_CONTROL_FAILURE",
    "STOP_ON_LEAKAGE",
    "STOP_ON_CIRCULAR_ENDPOINT",
    "STOP_ON_UNREGISTERED_THRESHOLD"
