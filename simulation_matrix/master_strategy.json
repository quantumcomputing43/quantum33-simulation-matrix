  "promotion_rule": "A scientific RESULT requires passing provenance, implementation, method, null/control, leakage, identifiability, robustness, falsification, and survivor checks.",
  "audit_invariant": "The orchestrator may execute registered operations and diagnose failures, but may not invent missing data, parameters, observables, thresholds, controls, or scientific conclusions.",
  "output_contract": {
    "master_report": "results/quantum33_master_report.json",
    "case_reports": "results/",
    "checkpoint": "state/master_checkpoint.json",
    "event_log": "logs/master_event_log.jsonl"
  }
