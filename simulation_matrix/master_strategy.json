    "VERIFY_PROVENANCE",
    "VERIFY_DATA_AND_UNITS",
    "VERIFY_GENERATIVE_MODEL",
    "VERIFY_CONTROLS_AND_NULLS",
    "VERIFY_METRIC_AND_ENDPOINT",
    "CHECK_LEAKAGE_AND_CIRCULARITY",
    "RUN_NUMERICAL_VALIDATION",
    "RUN_ADVERSARIAL_STRESS",
    "RUN_IDENTIFIABILITY",
    "RUN_ROBUSTNESS",
    "RUN_FALSIFICATION",
    "RUN_SURVIVOR_CHECK",
    "RUN_SCIENTIFIC_BATCHES_ONLY_IF_GATE_OPEN",
    "CHECKPOINT",
    "FINAL_AUDIT_REPORT"
  ],
  "case_pipelines": {
    "BHD": {
      "case_id": "bhd.hidden_sector",
      "adapter": "simulation_matrix.cases.bhd_master_runner",
      "current_gate": "CLOSED",
