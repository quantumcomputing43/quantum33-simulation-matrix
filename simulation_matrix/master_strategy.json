    },
    "miRNA21": {
      "case_id": "mirna21.quantum33",
      "adapter": "simulation_matrix.cases.mirna21_master_runner",
      "current_gate": "INPUT_AND_METHOD_AUDIT_REQUIRED",
      "frozen_primary_feature": "hsa-mir-21.MIMAT0000076",
      "analysis_family": [
        "Langmuir_single_binding",
        "NV_dipolar_transduction",
        "FIM_identifiability",
        "survival_validation",
        "expression_validation"
      ],
      "controls_required": [
